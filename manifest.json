{
  "manifest_version": 3,
  "name": "长按加速播放 (Long-Press Video Speed)",
  "version": "1.1.0",
  "description": "在网页视频中长按屏幕即可临时加速播放，松手自动恢复原速。适配 Edge / Chrome 桌面端。",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "长按加速播放 - 设置"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
