{
  "manifest_version": 3,
  "name": "长按加速播放 (Long-Press Video Speed)",
  "version": "1.3.0",
  "description": "适配 YouTube 和部分简单 HTML5 播放器；不适配已有原生长按倍速的抖音/TikTok。",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "长按加速播放 - 设置"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
